// Prisma Schema – Mercenary Customer App
// Database: Supabase PostgreSQL (shared with mercenary-admin)
//
// Setup:
//   1. Add DATABASE_URL (pooler, port 6543) and DIRECT_URL (direct, port 5432) to .env.local
//      See Supabase Dashboard → Settings → Database → Connection string
//   2. Run: npx prisma generate
//   NOTE: Do NOT run prisma migrate – the DB schema already exists on Supabase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String           @default("")
  price       Decimal          @db.Decimal(10, 2)
  image_url   String           @default("")
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  variants    ProductVariant[]
  messages    Message[]

  @@map("products")
}

model ProductVariant {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  size       String
  stock      Int      @default(0)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, size])
  @@map("product_variants")
}

// user_id references auth.users in Supabase (managed outside Prisma).
// product_id is an optional FK to products.
model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?  @db.Uuid
  product_id String?  @db.Uuid
  message    String
  reply      String?
  // status: "pending" | "replied" | "resolved"
  status     String   @default("pending")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  product    Product? @relation(fields: [product_id], references: [id])

  @@map("messages")
}
